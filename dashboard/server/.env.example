# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (MySQL)
DB_NAME=wildlife_monitoring
DB_USER=root
DB_PASSWORD=your_mysql_password
