# Wildlife Monitoring System - Environment Configuration
# Copy this file to .env and update the values

# =============================================================================
# Django Settings
# =============================================================================

# Generate a new secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-change-in-production

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# Database Configuration (MySQL)
# =============================================================================

DB_NAME=wildlife_monitoring
DB_USER=wildlife_user
DB_PASSWORD=your-secure-password
DB_HOST=localhost
DB_PORT=3306

# =============================================================================
# Celery Configuration
# =============================================================================

# Redis broker URL (default: localhost)
CELERY_BROKER_URL=redis://localhost:6379/0

# =============================================================================
# CORS Configuration
# =============================================================================

# Allowed origins for CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# AI Model Configuration
# =============================================================================

# Path to YOLO model file
AI_MODEL_PATH=../../best_models/best.pt

# Minimum confidence threshold for detections (0.0 - 1.0)
AI_CONFIDENCE_THRESHOLD=0.5

# =============================================================================
# Logging
# =============================================================================

DJANGO_LOG_LEVEL=INFO
